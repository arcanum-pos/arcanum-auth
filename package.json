{
  "name": "arcanum-auth",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc && tsc -p test",
    "test": "node --no-warnings test/check-passkey-script.mjs && vitest run",
    "test:watch": "vitest",
    "generate-key": "node scripts/generate-signing-key.mjs",
    "check": "npm run typecheck && npm test && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "$wrangler"
  }
}
