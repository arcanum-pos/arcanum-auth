{
  "name": "arcanum-auth",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc && tsc -p test",
    "test": "node --no-warnings test/check-passkey-script.mjs && node test/check-icons.mjs && vitest run",
    "test:watch": "vitest",
    "generate-key": "node scripts/generate-signing-key.mjs",
    "check": "npm run typecheck && npm test && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "$wrangler",
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  }
}
