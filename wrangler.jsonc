// arcanum-auth: the platform's own OpenID Connect provider (issuer), at
// login.kaboutersoft.be — the default identity provider for every Arcanum
// installation, in place of Auth0. See README.md.


{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arcanum-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	// Public, but only on its own hostname — never on *.workers.dev.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "login.kaboutersoft.be",
			"custom_domain": true
		}
	],
	// The favicon and icons (public/): served before the Worker runs.
	"assets": { "directory": "./public" },
	"observability": {
		"enabled": true
	},
	// Hourly clean-up: expired guests, old protocol state. Removing it here
	// later doesn't remove it from Cloudflare — do that in the dashboard too.
	"triggers": { "crons": ["17 * * * *"] },
	"dev": {
		"port": 8788
	},
	// PUBLIC_RATE_LIMITER (src/ratelimit.ts): 20 a minute per key — device
	// codes per client, Google sign-ins and passkey challenges per IP.
	"ratelimits": [{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } }],
		"vars": {
		// Must equal what arcanum's identity_providers.issuer_url (and the BFF's
		// default IdP) is configured with, character for character — the BFF
		// compares the id_token's `iss` to it. No trailing slash.
		"ISSUER": "https://login.kaboutersoft.be"
	},
	"d1_databases": [
		{
			// The code reads env.DB — keep this name.
			"binding": "DB",
			"database_name": "arcanum-auth",
			"database_id": "c6e24332-3100-48cd-acea-b8f728b9ae52",
			"migrations_dir": "migrations"
		}
	],
	// The mailed sign-in codes go through the platform's own
	// mailer, arcanum-platform-mailer (same account; same code as
	// arcanum-mailer, never an installation's). Remove this block to run
	// without it: codes are then only logged (fine for testing, not for
	// real users).
	"services": [
		{
			"binding": "MAILER",
			"service": "arcanum-platform-mailer"
		}
	],
	// Secrets (wrangler secret put …): SIGNING_KEY, ADMIN_API_KEY,
	// MAILER_INTERNAL_KEY, MAIL_SMTP (JSON), GOOGLE_CLIENT_ID,
	// GOOGLE_CLIENT_SECRET — see README.md.

	// Other instances, each on its own Cloudflare account (`--env <name>`).
	// Bindings and vars are not inherited from above: each block names its
	// own database, limits and mail - no MAILER here means no mailer needed
	// on that account. README.md, "Another instance".
	"env": {
		// zap: the target of an active ZAP scan (bertkaboutersoft account),
		// never for real users. No mail ever leaves it (MAIL_SENDING), no
		// Turnstile (no keys set), so the scan reaches what's behind them;
		// the hourly protection_off event says so. Workers Builds there, deploy command:
		// `npx wrangler d1 migrations apply DB --remote --env zap && npx wrangler deploy --env zap`.
		// (The MAILER warning on deploy is expected: no mailer here on purpose.)
		"zap": {
			"name": "arcanum-auth-zap",
			"workers_dev": true,
			"routes": [],
			// No mailer on that account: codes only in its log (wrangler tail).
			"services": [],
			"ratelimits": [{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } }],
			"vars": {
				"ISSUER": "https://arcanum-auth-zap.bertkaboutersoft.workers.dev",
				"MAIL_SENDING": "off"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcanum-auth-zap",
					"database_id": "TODO-zap-database-id",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}